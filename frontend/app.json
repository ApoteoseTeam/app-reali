{
  "expo": {
    "name": "realimenta",
    "slug": "app-realimenta",
    "owener": "apoteose-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icon.png",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/assets/app-icon.png"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/app-icon-symbol.png",
        "monochromeImage": "./src/assets/app-icon-symbol.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guilhermesandrade.apprealimenta"
    },
    "extra": {
      "eas": {
        "projectId": "a2b0820c-a9a9-48bf-b857-a26cede89e49"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF3",
          "image": "./src/assets/app-icon-symbol.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir ao Reali selecionar sua foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ]
  }
}
