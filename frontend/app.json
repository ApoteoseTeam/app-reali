{
  "expo": {
    "name": "realimenta",
    "slug": "app-realimenta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/r-logotipo-black (1).png",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/assets/logo-reali.png"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.guilhermesandrade.apprealimenta"
    },
    "extra": {
      "eas": {
        "projectId": "a2b0820c-a9a9-48bf-b857-a26cede89e49"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF3",
          "image": "./src/assets/logo-reali.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "defaultChannel": "reali" }],
      "expo-sharing",
      "expo-font"
    ]
  }
}
