# Em desenvolvimento a chave local padrão permite iniciar sem exportar esta variável.
# Em produção, exporte uma chave forte e exclusiva (50 caracteres ou mais).
# DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_THROTTLE_NUM_PROXIES=0
# Para PostgreSQL, preencha estas variáveis. Omita POSTGRES_DB para SQLite local.
POSTGRES_DB=reali
POSTGRES_USER=reali
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Configure o link e o transporte antes de emitir convites.
REALI_ACTIVATION_URL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=convites@reali.invalid
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
