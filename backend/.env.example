# Em desenvolvimento a chave local padrão permite iniciar sem exportar esta variável.
# Em produção, exporte uma chave forte e exclusiva (50 caracteres ou mais).
# DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_THROTTLE_NUM_PROXIES=0
# Para PostgreSQL, preencha estas variáveis. Omita POSTGRES_DB para SQLite local.
POSTGRES_DB=reali
POSTGRES_USER=reali
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Configure o link e o transporte antes de emitir convites.
REALI_ACTIVATION_URL=
REALI_PASSWORD_RESET_URL=

# Câmeras e agentes
CAMERA_HEARTBEAT_INTERVAL_SECONDS=30
CAMERA_OFFLINE_TIMEOUT_SECONDS=90
CAMERA_HEARTBEAT_MAX_CLOCK_SKEW_SECONDS=30
CAMERA_HEARTBEAT_MAX_AGE_SECONDS=300
CAMERA_MIN_PROCESSING_FPS=10
CAMERA_PENDING_EVENTS_LIMIT=100
CAMERA_HEALTH_RETENTION_DAYS=90
DEVICE_AUTH_FAILURE_LIMIT=20
CAMERA_LEGACY_AUTH_ENABLED=true
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=convites@reali.invalid
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Ingestão de contagens
DEVICE_COUNT_RATE=120/min
COUNT_BATCH_LIMIT=100
COUNT_MAX_BODY_BYTES=131072
COUNT_MAX_DELAY_SECONDS=86400
COUNT_MAX_FUTURE_SECONDS=300
# RealInova desligado por padrão
REALINOVA_ENABLED=false
REALINOVA_PROVIDER=openai
REALINOVA_MODEL=
REALINOVA_API_KEY=
REALINOVA_BASE_URL=
REALINOVA_INPUT_USD_PER_MTOK=
REALINOVA_OUTPUT_USD_PER_MTOK=
REALINOVA_TEMPERATURE=
REALINOVA_REQUEST_TIMEOUT_SECONDS=25
REALINOVA_MAX_OUTPUT_TOKENS=256
REALINOVA_MAX_INPUT_BYTES=24000
REALINOVA_MAX_TOOL_CALLS=6
REALINOVA_DAILY_REQUEST_LIMIT=25
REALINOVA_ORG_DAILY_REQUEST_LIMIT=250
REALINOVA_USER_DAILY_BUDGET_MICROUSD=1000000
REALINOVA_ORG_DAILY_BUDGET_MICROUSD=10000000
REALINOVA_FALLBACK_ENABLED=false
REALINOVA_CONVERSATION_RETENTION_DAYS=30
REALINOVA_TELEMETRY_RETENTION_DAYS=90
# Notifications. Generate each key with cryptography.fernet.Fernet.generate_key().
# Comma-separated Fernet keys, primary first. Leave blank to disable push registrations.
NOTIFICATION_PUSH_KEYS=
NOTIFICATION_EXPO_ACCESS_TOKEN=
NOTIFICATION_ALERT_DELAY_SECONDS=120
NOTIFICATION_ESCALATION_SECONDS=1800
NOTIFICATION_REMINDER_MINUTES=20
NOTIFICATION_STALE_MINUTES=60
NOTIFICATION_FORECAST_MIN_DIFFERENCE=20
NOTIFICATION_FORECAST_DIFFERENCE_PERCENT=30
NOTIFICATION_RETENTION_DAYS=180
ADMIN_AUDIT_RETENTION_DAYS=730
