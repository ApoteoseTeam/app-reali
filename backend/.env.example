# Em desenvolvimento a chave local padrão permite iniciar sem exportar esta variável.
# Em produção, exporte uma chave forte e exclusiva (50 caracteres ou mais).
# DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_THROTTLE_NUM_PROXIES=0
# Para PostgreSQL, preencha estas variáveis. Omita POSTGRES_DB para SQLite local.
POSTGRES_DB=reali
POSTGRES_USER=reali
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Configure o link e o transporte antes de emitir convites.
REALI_ACTIVATION_URL=
REALI_PASSWORD_RESET_URL=

# Câmeras e agentes
CAMERA_HEARTBEAT_INTERVAL_SECONDS=30
CAMERA_OFFLINE_TIMEOUT_SECONDS=90
CAMERA_HEARTBEAT_MAX_CLOCK_SKEW_SECONDS=30
CAMERA_HEARTBEAT_MAX_AGE_SECONDS=300
CAMERA_MIN_PROCESSING_FPS=10
CAMERA_PENDING_EVENTS_LIMIT=100
CAMERA_HEALTH_RETENTION_DAYS=90
DEVICE_AUTH_FAILURE_LIMIT=20
CAMERA_LEGACY_AUTH_ENABLED=true
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=convites@reali.invalid
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Ingestão de contagens
DEVICE_COUNT_RATE=120/min
COUNT_BATCH_LIMIT=100
COUNT_MAX_BODY_BYTES=131072
COUNT_MAX_DELAY_SECONDS=86400
COUNT_MAX_FUTURE_SECONDS=300
